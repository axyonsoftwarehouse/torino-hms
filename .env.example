# Supabase (região São Paulo / sa-east-1)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# URL pública do app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Fuso horário (evita deslocamento de slots/datas em servidores UTC, ex.: Vercel)
TZ="America/Sao_Paulo"

# Login de demonstração (opcional; mantenha desabilitado em produção)
NEXT_PUBLIC_DEMO_LOGIN="false"
NEXT_PUBLIC_DEMO_EMAIL=""
NEXT_PUBLIC_DEMO_PASSWORD=""
